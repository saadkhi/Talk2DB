# ── Application Database ──────────────────────────────────────────────────────
# PostgreSQL connection string for the application's own database (users, conversations, etc.)
DATABASE_URL="postgresql://username:password@localhost:5432/talk2db"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Secret key for JWT token signing — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"

# Full public URL of your app — required by NextAuth for OAuth callbacks and redirects
# Local dev:   http://localhost:3000
# Production:  https://your-deployed-domain.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ── GitHub OAuth (optional) ───────────────────────────────────────────────────
# Only needed if you want GitHub login. Create an OAuth App at:
# https://github.com/settings/developers
# Leave blank to disable GitHub login.
GITHUB_ID=""
GITHUB_SECRET=""

# ── Admin Panel ───────────────────────────────────────────────────────────────
# The email address that has access to /admin and the /api/admin/* routes.
# Must match the email the admin user registered/signed in with.
ADMIN_EMAIL="admin@example.com"

# Exposed to the browser for UI-only checks (e.g. highlighting the admin badge).
# Must match ADMIN_EMAIL exactly.
NEXT_PUBLIC_ADMIN_EMAIL="admin@example.com"

# ── AI Providers ──────────────────────────────────────────────────────────────
# Primary LLM — Google Gemini (free, fast, works on Vercel serverless)
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Gemini model to use (defaults to gemini-2.5-flash-lite if not set)
GEMINI_MODEL="gemini-2.5-flash-lite"

# Fallback LLM — OpenRouter (used when Gemini is unavailable)
# REQUIRED as fallback — get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-your-openrouter-api-key-here"

# OpenRouter base URL (optional, defaults to https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# OpenRouter model — use a free model to avoid charges
# Full model list: https://openrouter.ai/models
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# ── Hugging Face / Gradio (optional SQL model) ────────────────────────────────
# Gradio space name for the fine-tuned SQL model
GRADIO_SPACE="saadkhi/SQL_chatbot_API"

# Hugging Face API Token — optional, only required for private spaces
HF_TOKEN=""

# ── Database Connection Encryption ───────────────────────────────────────────
# 32-byte (64 hex character) key used to AES-256-CBC encrypt user DB connection strings.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: changing this key will invalidate all existing stored connection strings.
DB_ENCRYPTION_KEY="your-64-hex-character-encryption-key-here"

# ── Node Environment ──────────────────────────────────────────────────────────
NODE_ENV="development"
