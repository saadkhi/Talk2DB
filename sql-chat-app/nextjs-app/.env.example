# ── Application Database ──────────────────────────────────────────────────────
# PostgreSQL connection string for the application's own database (users, conversations, etc.)
DATABASE_URL="postgresql://username:password@localhost:5432/talk2db"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Secret key for JWT token signing — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"

# Full public URL of your app — required by NextAuth for OAuth callbacks and redirects
# Local dev:   http://localhost:3000
# Production:  https://your-deployed-domain.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ── GitHub OAuth (optional) ───────────────────────────────────────────────────
# Only needed if you want GitHub login. Create an OAuth App at:
# https://github.com/settings/developers
# Leave blank to disable GitHub login.
GITHUB_ID=""
GITHUB_SECRET=""

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# Only needed if you want Google login (recommended for data teams).
# Create OAuth credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Leave blank to disable Google login.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Email Verification (Gmail SMTP) ──────────────────────────────────────────
# Used to send OTP verification codes to new users.
# GMAIL_USER must be a Gmail address. GMAIL_APP_PASSWORD is a 16-char App Password
# (NOT your Gmail login password). Generate one at:
# https://myaccount.google.com/apppasswords  (requires 2FA to be enabled)
GMAIL_USER="talk2db.org@gmail.com"
GMAIL_APP_PASSWORD="zzjpsjbatpdvlnpc"
# The email address that has access to /admin and the /api/admin/* routes.
# Must match the email the admin user registered/signed in with.
ADMIN_EMAIL="admin@example.com"

# Exposed to the browser for UI-only checks (e.g. highlighting the admin badge).
# Must match ADMIN_EMAIL exactly.
NEXT_PUBLIC_ADMIN_EMAIL="admin@example.com"

# ── AI Providers ──────────────────────────────────────────────────────────────
# Set ANY combination of keys below — the app auto-detects which are configured
# and tries them in order until one succeeds. You only need ONE key to work.
#
# Default priority: APIFreeLLM → Gemini → OpenAI → OpenRouter → Anthropic
# Override with: LLM_PROVIDER=gemini  (or apifreellm / openai / openrouter / anthropic)

# --- APIFreeLLM (free, unlimited — https://apifreellm.com/en/api-access) ---
# Sign in with Google to get your key. No credit card needed.
# NOTE: Free tier has ~25s response delay. Works locally; may timeout on Vercel (10s limit).
# For Vercel production, use Gemini or OpenRouter instead.
FREEAPI_KEY="your-apifreellm-key-here"

# --- Google Gemini (free tier, fast, works on Vercel) ---
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
# Model to use (default: gemini-1.5-flash)
# Other options: gemini-1.5-pro, gemini-2.0-flash, gemini-2.5-flash
GEMINI_MODEL="gemini-1.5-flash"

# --- OpenAI (or any OpenAI-compatible API) ---
# Works with: OpenAI, Together AI, Groq, Fireworks AI, Mistral, etc.
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"
#   Groq:     OPENAI_BASE_URL="https://api.groq.com/openai/v1"
#   Together: OPENAI_BASE_URL="https://api.together.xyz/v1"

# --- OpenRouter (100+ models, free tier available — https://openrouter.ai/keys) ---
# OPENROUTER_API_KEY="sk-or-..."
# OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# --- Anthropic Claude ---
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-3-haiku-20240307"

# Which provider to try first (optional)
# Default priority: apifreellm → gemini → openai → openrouter → anthropic
# LLM_PROVIDER="gemini"

# ── Hugging Face / Gradio (optional SQL model) ────────────────────────────────
# Gradio space name for the fine-tuned SQL model
GRADIO_SPACE="saadkhi/SQL_chatbot_API"

# Hugging Face API Token — optional, only required for private spaces
HF_TOKEN=""

# ── Database Connection Encryption ───────────────────────────────────────────
# 32-byte (64 hex character) key used to AES-256-CBC encrypt user DB connection strings.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: changing this key will invalidate all existing stored connection strings.
DB_ENCRYPTION_KEY="your-64-hex-character-encryption-key-here"

# ── Node Environment ──────────────────────────────────────────────────────────
NODE_ENV="development"
