generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String         @id @default(cuid())
  name                  String?
  email                 String         @unique
  password              String?        // bcrypt hashed
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  connections           DbConnection[]
  dashboardItems        DashboardItem[]
  conversations         Conversation[]
  savedReports          SavedReport[]
  savedQueries          SavedQuery[]
  auditLogs             AuditLog[]
  accounts              Account[]
  sessions              Session[]
  // Phase 6
  llmUsage              LlmUsage[]
  teamMemberships       TeamMember[]
  teamQueries           TeamQuery[]    @relation("TeamQueryAuthor")
  teamDashboardItems    TeamDashboardItem[] @relation("TeamDashboardAuthor")
}

model DbConnection {
  id                 String   @id @default(cuid())
  userId             String
  name               String
  dbConnectionString String
  dbDialect          String
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DashboardItem {
  id        String   @id @default(cuid())
  userId    String
  title     String
  type      String   // "chart" | "metric" | "table"
  sql       String
  config    String?  // JSON string
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String       // "user" | "assistant"
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model SavedReport {
  id        String   @id @default(cuid())
  userId    String
  title     String
  prompt    String
  sql       String
  chartType String?
  summary   String?
  insights  String[] // array of strings
  schedule  String?  // cron string (e.g., "0 9 * * 1" for Mondays at 9am)
  lastRunAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedQuery {
  id        String   @id @default(cuid())
  userId    String
  title     String
  sql       String
  tags      String[] // array of strings for tags
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Audit log ─────────────────────────────────────────────────────────────────
// One row per SQL query executed against a user's connected database.
// Keeps a record of who ran what, when, and whether it succeeded.
model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  /// The SQL that was sent to the database (may be truncated to 4000 chars)
  sql         String
  /// Source endpoint: "query" | "chat" | "visualize" | "report" etc.
  source      String
  /// Whether the query completed successfully
  success     Boolean
  /// Error message if success = false; null otherwise
  errorMessage String?
  /// Execution time in milliseconds (null if not measured)
  durationMs  Int?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ── LLM Usage tracking (Phase 6.6) ────────────────────────────────────────────
// One row per LLM call. Used for per-user usage metering and billing prep.
model LlmUsage {
  id           String   @id @default(cuid())
  userId       String
  /// Which provider was used: "openrouter" | "gemini" | "openai" | "anthropic"
  provider     String
  /// The model name actually called (e.g. "gemini-1.5-flash")
  model        String
  /// Rough token estimate for the prompt (characters / 4)
  promptTokens Int      @default(0)
  /// Source feature: "chat" | "query" | "report" | "visualize" | "profile" etc.
  source       String
  /// Whether the LLM call succeeded
  success      Boolean
  /// Wall-clock time for the call in ms
  durationMs   Int?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ── Team / Workspace (Phase 6.1) ──────────────────────────────────────────────
model Team {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TeamMember[]
  teamDbs     TeamDb[]
  sharedQueries TeamQuery[]
  sharedDashboards TeamDashboardItem[]

  @@index([slug])
}

// Role values: "owner" | "editor" | "viewer"
model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   @default("viewer")
  joinedAt  DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

// Shared database connections visible to the whole team
model TeamDb {
  id                 String   @id @default(cuid())
  teamId             String
  name               String
  dbConnectionString String   // AES-256 encrypted
  dbDialect          String   @default("postgresql")
  createdAt          DateTime @default(now())
  team               Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

// Shared query library (Phase 6.2)
model TeamQuery {
  id          String   @id @default(cuid())
  teamId      String
  authorId    String
  title       String
  sql         String
  tags        String[]
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author      User     @relation("TeamQueryAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([authorId])
}

// Shared dashboards (Phase 6.3)
model TeamDashboardItem {
  id        String   @id @default(cuid())
  teamId    String
  authorId  String
  title     String
  type      String   // "chart" | "metric" | "table"
  sql       String
  config    String?  // JSON string
  pinned    Boolean  @default(true)
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author    User     @relation("TeamDashboardAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([teamId])
}
