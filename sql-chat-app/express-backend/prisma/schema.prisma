generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String         @id @default(cuid())
  name                  String?
  email                 String         @unique
  password              String?        // bcrypt hashed
  dbConnectionString    String?        // AES-256 encrypted user's own DB URL
  dbDialect             String?        // "postgresql" | "mysql" | "sqlite"
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  conversations         Conversation[]
  savedReports          SavedReport[]
  savedQueries          SavedQuery[]
  auditLogs             AuditLog[]
  accounts              Account[]
  sessions              Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String       // "user" | "assistant"
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model SavedReport {
  id        String   @id @default(cuid())
  userId    String
  title     String
  prompt    String
  sql       String
  chartType String?
  summary   String?
  insights  String[] // array of strings
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedQuery {
  id        String   @id @default(cuid())
  userId    String
  title     String
  sql       String
  tags      String[] // array of strings for tags
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Audit log ─────────────────────────────────────────────────────────────────
// One row per SQL query executed against a user's connected database.
// Keeps a record of who ran what, when, and whether it succeeded.
model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  /// The SQL that was sent to the database (may be truncated to 4000 chars)
  sql         String
  /// Source endpoint: "query" | "chat" | "visualize" | "report" etc.
  source      String
  /// Whether the query completed successfully
  success     Boolean
  /// Error message if success = false; null otherwise
  errorMessage String?
  /// Execution time in milliseconds (null if not measured)
  durationMs  Int?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
